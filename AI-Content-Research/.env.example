# ============================================================
# AI Content Research Framework — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- Ollama ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
# Layers offloaded to GPU. Set -1 for automatic VRAM management by Ollama.
OLLAMA_NUM_GPU_LAYERS=-1
OLLAMA_TIMEOUT_SECONDS=120

# --- Models ---
# Model for extraction, classification, summarization, tool calling
LLM_EXTRACTION_MODEL=qwen3:14b
# Model for reasoning, pattern detection, hypothesis validation
LLM_REASONING_MODEL=deepseek-r1:8b

# --- Browser ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720

# --- Storage ---
# Base directory for all generated output
STORAGE_OUTPUT_DIR=./output

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=./logs
